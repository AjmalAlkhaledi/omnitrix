APP_NAME=Omnitrix
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080
# Run `php omnitrix key:generate` to set it (encryption, sessions, signed URLs).
APP_KEY=
LOG_LEVEL=info

SERVER_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_WORKERS=4

DB_DRIVER=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=omnitrix
DB_USERNAME=omnitrix
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=omnitrix:

QUEUE_NAME=default
QUEUE_CONCURRENCY=4

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Omnitrix

FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=
