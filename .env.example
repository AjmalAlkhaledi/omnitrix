APP_NAME=Omnitrix
APP_ENV=local
APP_DEBUG=true
# Run `php omnitrix key:generate` to set it (encryption, sessions, signed URLs).
APP_KEY=
LOG_LEVEL=info

SERVER_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_WORKERS=4

DB_DRIVER=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=omnitrix
DB_USERNAME=omnitrix
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=omnitrix:

QUEUE_NAME=default
QUEUE_CONCURRENCY=4
