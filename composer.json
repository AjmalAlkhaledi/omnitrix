{
    "name": "omnitrix/omnitrix",
    "description": "Application skeleton for the Omnitrix framework: asynchronous PHP APIs on OpenSwoole.",
    "type": "project",
    "license": "MIT",
    "keywords": ["omnitrix", "framework", "api", "skeleton", "async", "openswoole"],
    "authors": [
        {
            "name": "Ajmal Alkhaledi",
            "email": "ajmalalkhaledi@gmail.com",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-openswoole": ">=26.2.0",
        "ext-pdo_mysql": "*",
        "ext-redis": "*",
        "omnitrix/framework": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Database\\Seeds\\": "database/seeds/"
        }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php -r \"echo PHP_EOL, 'Omnitrix application ready.', PHP_EOL, 'Configure .env, then run: php omnitrix migrate && php omnitrix serve', PHP_EOL;\""
        ],
        "serve": "@php omnitrix serve",
        "test": "vendor/bin/omnitrix-phpunit"
    }
}
